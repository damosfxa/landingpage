# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Tanpa garis miring di depan, supaya berlaku di semua kedalaman -- pola lama
# `/node_modules` hanya mengunci root, sehingga `tools/maps-scraper/node_modules`
# ikut ter-commit (4.480 file).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Artefak run Playwright (trace, screenshot, error-context) -- regenerate tiap
# `npm run test:a11y`, tidak ada gunanya masuk repo.
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Data pribadi/finansial yang tidak boleh ikut ke Git (repo ini publik).
*.local.md

# Hasil scraping berisi kontak pihak ketiga: nama bisnis, nomor telepon, link Maps.
# Aturan di atas sudah ada sejak awal tapi tidak menyebut format ini, sehingga
# `tools/maps-scraper/leads-voxy-seo-master.csv` lolos ke repo publik.
tools/**/*.csv
tools/**/*.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
